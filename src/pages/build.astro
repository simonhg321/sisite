---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Figure from "../components/Figure.astro";
import { withBase } from "../lib/url";

const screens = [
  {
    src: "/screens/screen-interface.png",
    alt: "Internal command-center dashboard showing fleet metrics",
    title: "The Interface",
    caption:
      "The fleet's command center: live status, metrics, and the internal blog that gets promoted to the public log.",
  },
  {
    src: "/screens/screen-blog.png",
    alt: "Internal blog editor with Promote control and a promoted post",
    title: "The Skipper — internal → public",
    caption:
      "Internal-first writing. One Promote button is the only thing that talks outward, behind a sanitizer that redacts internal addresses.",
  },
  {
    src: "/screens/screen-iot.png",
    alt: "Home-network visibility dashboard with VLAN distribution",
    title: "The Home — network visibility",
    caption:
      "Five VLANs designed by the AI and executed by the human, an intruder watch every five minutes, and a SQLite index over ~1.7M log lines where plain English becomes SQL and an Analyze button returns a security-analyst writeup. The Bloomberg/Gigamon visibility career, run at home on a local model.",
  },
];
---

<Base
  title="What I build — Simon Gibson"
  description="Production AI systems running today. Proof of Human Work, See it think, Blade-Book, and a fleet of Claude agents in production."
>
  <section class="head">
    <div class="wrap">
      <p class="kicker reveal">What I ship now</p>
      <h1 class="head__h reveal" style="animation-delay: 90ms">
        I don't talk about AI. I run it in production.
      </h1>
      <p class="lede reveal" style="animation-delay: 200ms">
        Live systems with Claude in the decision loop, real users, and an open
        model on my own GPU that teaches a room. Built and operated solo.
      </p>
    </div>
  </section>

  <section class="builds">
    <div class="wrap builds__grid">
      <ProjectCard
        n="01"
        lead={true}
        name="Proof of Human Work (PHW)"
        tagline="Prove your work. Own your proof. Trust no platform."
        body="A public protocol for the deepfake era. The thesis: <strong>machine output is now the background; human work is the signal</strong> — and that signal needs cryptographic verification. Three guarantees — Privacy, Truth, Proof: raw data stays encrypted locally, assertions are signed to evidence you control, and any verifier confirms offline with no platform in the middle. Beneath it sits the Vault: an encrypted local store on a Mac Mini with a local model, authenticated encryption at rest, and nothing leaving the network."
        links={[{ href: "https://instockornot.club/the_vault", label: "instockornot.club/the_vault" }]}
      />

      <ProjectCard
        n="02"
        wide={true}
        name="See it think — a wall that shows a room what a model is doing"
        tagline="Every word you see was picked from 150,000 options. Then it did that again for the next word."
        body="A teaching wall for people who use chat models every day and have never seen inside one. An open model (Qwen3, gpt-oss, a dozen others, switchable from the wall) answers prepared questions on a single GPU, and the room watches: <strong>every token colored by how sure the model was</strong>, the five guesses it almost made instead, the context window filling and then forgetting, temperature and top-p as live dials, and the same brain under different instructions. The anchor demo is a changed Monty Hall: ask it to show its steps and it gets it right; ask for a confident one-liner and it is confidently wrong. <strong>Confidence measures familiarity, not correctness.</strong> It runs on the L40 at Gonzaga University's IIAT lab, where I'm the volunteer sysadmin (verified backups, the monitoring that had been dead since install, a shared inference layer), and on a public copy that I showed at a credit union's AI all-hands. The public copy is behind a key; write me for it."
        image={{
          src: withBase("/screens/screen-wall.png"),
          alt: "The See it think wall: a question, the answer colored token by token by confidence, the top guesses it almost said, and the context-window and GPU tiles",
        }}
        specs={[
          { label: "Engine", value: "vLLM on one NVIDIA L40" },
          { label: "Shows", value: "per-token odds · roads not taken · context fill" },
          { label: "Shown to", value: "a university lab · an all-hands of security people" },
        ]}
        links={[
          { href: "https://demo.instockornot.club", label: "demo.instockornot.club (key required)" },
          { href: withBase("/See-It-Think-Cheat-Sheet.md"), label: "the cheat sheet" },
        ]}
      />

      <ProjectCard
        n="03"
        name="Blade-Book"
        tagline="One photo. Your whole collection, on the record."
        body="A registry for knife collectors. Photograph the knife next to its birth card and <strong>Claude reads the card</strong>, fills in the record, and gives the knife its own page. Private by default, shared only when the owner says so, with full export and deletion. Grew out of The Billboard, a Claude-in-the-loop alert engine that watched 94+ dealer sites and sent carrier-approved SMS when a grail dropped, and still feeds it. In beta, with early adoption growing."
        specs={[
          { label: "Stack", value: "Flask · SQLite · Linode behind Cloudflare" },
          { label: "Reads the card", value: "one schema-forced Claude call per knife" },
          { label: "Public pages", value: "static per collector · the DB never sees public traffic" },
          { label: "Sign-in", value: "Apple · Google · magic link" },
          { label: "Tests", value: "814" },
          { label: "Status", value: "beta · early adoption growing" },
        ]}
        links={[
          { href: "https://blade-book.com", label: "blade-book.com" },
        ]}
      />

      <ProjectCard
        n="04"
        name="The Castaways — a fleet, and the blog that is its spine"
        body="A fleet of Claude agents across five machines, coordinating through a shared internal blog that is the spine of the org. Internal-first, always. Interesting stories get <strong>promoted</strong> to the public log — and one Promote button is the only thing that talks to the outside world, behind a preflight sanitizer that redacts internal addresses and vault paths."
        quote="It's not &lsquo;I use AI.&rsquo; It's a fleet running under a contract I wrote, in production, every day."
        links={[
          { href: "https://instockornot.club/blog.html", label: "The Skipper — public log" },
        ]}
      />
    </div>
  </section>

  <section class="gallery">
    <div class="wrap">
      <p class="kicker">Under the hood at home</p>
      <h2 class="gallery__h">The visibility career, run at home.</h2>
      <p class="lede gallery__lede">
        Three internal tools on the home network, shown as sanitized
        screenshots, never linked. Captions describe capability, never
        internal addresses.
      </p>
      <div class="gallery__grid">
        {screens.map((s) => <Figure {...s} src={withBase(s.src)} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(56px, 9vw, 110px) clamp(24px, 4vw, 52px);
  }
  .head__h {
    margin-top: 22px;
    max-width: 16ch;
  }
  .head .lede {
    margin-top: 26px;
  }
  .builds {
    padding-block: clamp(8px, 2vw, 24px) clamp(40px, 7vw, 80px);
  }
  .builds__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .builds__grid > :global(.proj--wide) {
    grid-column: 1 / -1;
  }
  .gallery {
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 8vw, 96px);
  }
  .gallery__h {
    margin-top: 16px;
  }
  .gallery__lede {
    margin-top: 18px;
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 820px) {
    .builds__grid,
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
