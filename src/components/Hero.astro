---
import { withBase } from "../lib/url";
---

<section class="hero">
  <div class="wrap">
    <p class="kicker reveal" style="animation-delay: 0ms">
      Security leadership → a safety layer for AI
    </p>

    <h1 class="hero__head reveal" style="animation-delay: 90ms">
      I've spent 25 years making powerful,
      wonderful systems <em>trustworthy</em> enough
      to run the world's networks, banks, and governments.
    </h1>

    <p class="lede hero__lede reveal" style="animation-delay: 220ms">
      First the streaming media and the DNS root. Now the AI layer that's about to sit on top of all of it.
      I'm not here to study this next one — <strong>I'm here to build.</strong>
    </p>

    <div class="hero__cta reveal" style="animation-delay: 340ms">
      <a href={withBase("/build")} class="btn solid">
        See what I ship <span class="arr">→</span>
      </a>
      <a href={withBase("/experience")} class="btn">The 25-year record</a>
    </div>

    <dl class="hero__stats reveal" style="animation-delay: 460ms">
      <div>
        <dt class="num">$500M+</dt>
        <dd>gov revenue closed at Gigamon</dd>
      </div>
      <div>
        <dt class="num">L2–L8</dt>
        <dd>network visibility, down to the human layer</dd>
      </div>
      <div>
        <dt class="num">30+</dt>
        <dd>Claude sessions a week, in production</dd>
      </div>
      <div>
        <dt class="num">4</dt>
        <dd>patents in network visibility &amp; streaming</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(64px, 12vw, 150px) clamp(48px, 8vw, 96px);
    position: relative;
  }
  .hero__head {
    margin-top: 26px;
    max-width: 18ch;
    font-weight: 460;
  }
  .hero__head em {
    color: var(--ember);
    font-style: italic;
  }
  .hero__lede {
    margin-top: 30px;
    max-width: 56ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: clamp(48px, 7vw, 84px);
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .hero__stats > div {
    background: linear-gradient(180deg, var(--panel), var(--ink));
    padding: 22px 22px 20px;
  }
  .hero__stats dt {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--white);
    letter-spacing: -0.02em;
  }
  .hero__stats dd {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ash);
  }
  @media (max-width: 760px) {
    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
