---
interface Item {
  title: string;
  href: string;
  meta?: string;
}
interface Props {
  heading: string;
  source: string;
  items: Item[];
}
const { heading, source, items } = Astro.props;
---

<section class="pubs">
  <header class="pubs__head">
    <h3>{heading}</h3>
    <span class="pubs__source mono">{source}</span>
  </header>
  <ul class="pubs__list">
    {
      items.map((it) => (
        <li class="pubs__item">
          <a href={it.href} class="pubs__link" rel="noopener" target="_blank">
            <span class="pubs__title">{it.title}</span>
            {it.meta && <span class="pubs__meta mono">{it.meta}</span>}
            <span class="pubs__arr mono" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pubs {
    margin-top: 44px;
  }
  .pubs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-2);
  }
  .pubs__head h3 {
    font-size: 1.4rem;
  }
  .pubs__source {
    font-size: 12px;
    color: var(--faint);
  }
  .pubs__list {
    list-style: none;
  }
  .pubs__link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 16px;
    padding: 15px 4px;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.25s var(--ease), background 0.2s;
  }
  .pubs__link:hover {
    padding-left: 14px;
    background: linear-gradient(90deg, var(--panel), transparent);
  }
  .pubs__title {
    font-size: 15.5px;
    color: var(--silver);
    transition: color 0.2s;
  }
  .pubs__link:hover .pubs__title {
    color: var(--white);
  }
  .pubs__meta {
    font-size: 11.5px;
    color: var(--faint);
  }
  .pubs__arr {
    color: var(--faint);
    transition: color 0.2s, transform 0.25s var(--ease);
  }
  .pubs__link:hover .pubs__arr {
    color: var(--ember);
    transform: translate(2px, -2px);
  }
  @media (max-width: 600px) {
    .pubs__link {
      grid-template-columns: 1fr auto;
    }
    .pubs__meta {
      display: none;
    }
  }
</style>
