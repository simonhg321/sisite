---
import { withBase, isActivePath } from "../lib/url";

const links = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
  { href: "/build", label: "Build" },
  { href: "/hands-on-ai", label: "Hands-On AI" },
  { href: "/writing", label: "Writing" },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname;
const isActive = (href: string) => isActivePath(current, href);
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href={withBase("/")} class="nav__brand" aria-label="Simon Gibson — home">
      <span class="nav__mark">SG</span>
      <span class="nav__name">Simon Gibson</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav__burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={withBase(l.href)}
            class:list={["nav__link", { "is-active": isActive(l.href) }]}
            aria-current={isActive(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <button id="theme-toggle" class="nav__theme" type="button" aria-label="Switch between light and dark">
      <svg class="ic ic--sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <svg class="ic ic--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var cur = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
      var next = cur === "light" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (e) {}
    });
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--black) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 62px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .nav__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    border: 1px solid var(--ember);
    color: var(--ember);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .nav__name {
    color: var(--white);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .nav__theme {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: 10px;
    border: 1px solid var(--border-2);
    border-radius: 8px;
    background: var(--panel);
    color: var(--ash);
    cursor: pointer;
    transition: color 0.2s, border-color 0.25s, transform 0.25s var(--ease);
  }
  .nav__theme:hover {
    color: var(--ember);
    border-color: var(--ember);
    transform: translateY(-2px);
  }
  .nav__theme .ic {
    display: none;
  }
  :global(html[data-theme="dark"]) .nav__theme .ic--sun {
    display: block;
  }
  :global(html[data-theme="light"]) .nav__theme .ic--moon {
    display: block;
  }
  .nav__link {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ash);
    padding: 8px 12px;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }
  .nav__link:hover {
    color: var(--white);
    background: var(--panel);
  }
  .nav__link.is-active {
    color: var(--ember);
  }

  .nav__toggle,
  .nav__burger {
    display: none;
  }

  @media (max-width: 720px) {
    .nav__burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0 8px;
      margin-left: auto;
      border: 1px solid var(--border-2);
      border-radius: 7px;
      cursor: pointer;
    }
    .nav__theme {
      order: 1;
    }
    .nav__burger span {
      height: 1.5px;
      background: var(--silver);
      transition: transform 0.3s var(--ease), opacity 0.2s;
    }
    .nav__links {
      position: absolute;
      top: 62px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      background: var(--ink);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.35s var(--ease), opacity 0.25s;
    }
    .nav__link {
      padding: 13px 8px;
      font-size: 14px;
      border-bottom: 1px solid var(--border);
    }
    .nav__toggle:checked ~ .nav__links {
      max-height: 70vh;
      opacity: 1;
    }
    .nav__toggle:checked ~ .nav__burger span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }
    .nav__toggle:checked ~ .nav__burger span:nth-child(2) {
      opacity: 0;
    }
    .nav__toggle:checked ~ .nav__burger span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }
  }
</style>
