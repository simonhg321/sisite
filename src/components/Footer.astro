---
const year = new Date().getFullYear();
const links = [
  { href: "mailto:simon@instockornot.club", label: "simon@instockornot.club" },
  { href: "https://www.linkedin.com/in/simonhg", label: "in/simonhg" },
  { href: "https://github.com/simonhg321", label: "github.com/simonhg321" },
];
---

<footer class="ft">
  <hr class="rule" />
  <div class="wrap ft__inner">
    <div class="ft__id">
      <span class="ft__name">Simon Gibson</span>
      <span class="ft__line mono">Build it · Secure it · Make it safe · Sell it.</span>
    </div>
    <nav class="ft__links" aria-label="Contact">
      {links.map((l) => <a href={l.href} class="ulink mono">{l.label}</a>)}
    </nav>
    <span class="ft__copy mono">© {year}</span>
  </div>
</footer>

<style>
  .ft {
    padding-bottom: 56px;
  }
  .ft__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 36px;
    padding-top: 32px;
  }
  .ft__id {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-right: auto;
  }
  .ft__name {
    font-family: var(--serif);
    font-size: 1.25rem;
  }
  .ft__line {
    font-size: 11.5px;
    color: var(--faint);
    letter-spacing: 0.04em;
  }
  .ft__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 12.5px;
  }
  .ft__copy {
    font-size: 12px;
    color: var(--faint);
  }
</style>
